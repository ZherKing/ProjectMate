DATABASE_URL=file:./database.sqlite
AUTH_SECRET=change-me
# 本站对外访问地址；MCP授权与回调使用此地址，生产环境请配置HTTPS域名
AUTH_URL=http://localhost:3000
# 可选：逗号分隔的管理员邮箱白名单；未配置时所有账号均为普通用户
ADMIN_EMAILS=
# DeepSeek 服务端配置；API Key 不要暴露给浏览器
# 在此填写 DeepSeek 控制台创建的 API Key，仅服务端读取
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
STORAGE_PATH=./storage
# 项目文件配额（MB，包含历史版本）
PROJECT_FILE_MAX_MB=20
PROJECT_STORAGE_MAX_MB=500
# 远程 MCP 浏览器客户端的额外 Origin 白名单，逗号分隔；桌面客户端无需配置
MCP_ALLOWED_ORIGINS=
CRAWLER_USER_AGENT=ProjectMateBot/1.0
# 可选：赛氪公开 JSON 列表接口
SAIKR_API_URL=
# 可选：传智杯公开赛道接口
BOXUEGU_TRACK_API_URL=
BOXUEGU_CONTESTS_URL=https://www.boxuegu.com/matchTrack/
# 可选：172校园赛事网开发应用分类
XIAOYUAN172_CONTESTS_URL=http://bisai.172xiaoyuan.com/kaifayingyong/
XIAOYUAN172_MAX_PAGES=3

# GitHub OAuth App（仅身份资料，不申请仓库权限）
# Authorization callback URL: AUTH_URL + /api/settings/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 通知邮件复用管理员后台SMTP；用户需在个人设置验证通知邮箱。
# Webhook仅接受公网HTTPS（不接受内网/元数据地址），密钥由保存配置时生成。
# 常驻Node进程每15秒投递一次；无常驻进程时可定时POST /api/notifications/deliver
# 定时请求需带 Authorization: Bearer <NOTIFICATION_CRON_SECRET>
NOTIFICATION_CRON_SECRET=

# 极验 4.0：仅登录/注册流程的人机验证；只能通过服务器环境配置启用。
# true（或1）启用；未启用不加载极验。不配置正确ID/KEY会阻止受保护操作。
GEETEST_ENABLED=false
GEETEST_ID=
GEETEST_KEY=
